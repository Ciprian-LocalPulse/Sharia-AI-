# ==============================================================================
# Sharia-AI — نموذج متغيرات البيئة (env vars)
# انسخ هذا الملف إلى `.env` واملأ القيم الحقيقية قبل النشر في الإنتاج.
# لا تُدرِج ملف `.env` الحقيقي أبدًا في نظام التحكم بالإصدار (Git) — راجع .gitignore.
# ==============================================================================

# --- الأمان: مفاتيح API (إلزامي في الإنتاج) ---
# قائمة مفاتيح مفصولة بفواصل. إذا تُركت فارغة، تُعطَّل المصادقة تلقائيًا
# (وضع تطوير محلي فقط — لا تنشر هكذا في الإنتاج!).
# ولّد مفتاحًا عشوائيًا آمنًا، مثال: python -c "import secrets; print(secrets.token_urlsafe(32))"
SHARIA_AI_API_KEYS=

# فرض التحقق من مفتاح API (افتراضيًا: true). لا تُعطّله في الإنتاج.
SHARIA_AI_REQUIRE_API_KEY=true

# --- الأمان: CORS ---
# أصول (origins) مسموح لها بالوصول عبر المتصفح، مفصولة بفواصل.
# اتركه فارغًا لتعطيل CORS تمامًا (مناسب إذا كانت الواجهة البرمجية server-to-server فقط).
SHARIA_AI_CORS_ORIGINS=https://your-frontend-domain.com

# --- تحديد معدّل الطلبات (Rate limiting) ---
SHARIA_AI_RATE_LIMIT_REQUESTS=60
SHARIA_AI_RATE_LIMIT_WINDOW_SECONDS=60

# --- حدود حجم المُدخلات ---
SHARIA_AI_MAX_CONTRACT_CHARS=50000

# --- سجلّ التدقيق (Audit trail) ---
SHARIA_AI_AUDIT_ENABLED=true
# في الإنتاج، يُفضَّل مسار على قرص دائم (persistent volume)، وليس المسار المحلي للحاوية.
SHARIA_AI_AUDIT_DB_PATH=/data/sharia_ai_audit.sqlite3

# --- بيانات مالية أساسية ---
SHARIA_AI_GOLD_PRICE_PER_GRAM=75.0
SHARIA_AI_SILVER_PRICE_PER_GRAM=0.95
SHARIA_AI_CURRENCY=USD

# --- بيئة التشغيل والتسجيل ---
SHARIA_AI_ENV=production
SHARIA_AI_LOG_LEVEL=INFO
